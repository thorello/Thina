# LLM: deepseek (padrao) ou gemini
LLM_PROVIDER=deepseek

# DeepSeek (API compativel com OpenAI — https://api.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=90

# Gemini (opcional, se LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Pesquisa na web via Google Search (conhecimento geral, noticias, etc.)
GEMINI_GOOGLE_SEARCH=true

# Home Assistant
# --- Stack Docker (docs/instalacao.md): URLs ja definidas no docker-compose.yml ---
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=
# --- Modo nativo Windows (start.ps1): HA via Docker no WSL ---
# start/stop/restart: sobe HA via Docker no WSL (scripts/ha/docker-compose.yml)
HOME_ASSISTANT_MANAGED=true
# Distro WSL com Docker (padrao nos scripts: Ubuntu). Ajuste se o nome for outro.
# Apos mover o WSL para outro disco (ex. D:), rode wsl --shutdown antes de start.ps1.
WSL_DISTRO=Ubuntu
# Docker so no WSL (sem Docker Desktop): descomente para scripts PowerShell usarem WSL
# DOCKER_VIA_WSL=true

# Kokoro TTS (submodulo Git em kokoro/ — veja install.ps1)
# Caminho alternativo legado: ../kokoro
KOKORO_DIR=kokoro
KOKORO_SERVER_URL=http://localhost:8000
# thina_mix = media igual das vozes em kokoro/assets/voices/*/ (*.pt)
# Tina: Dora + 30% Bella (ex.: pf_dora + af_bella a 0.3)
KOKORO_VOICE=pf_dora
KOKORO_MIX_VOICE=af_bella
KOKORO_MIX_AMOUNT=0.3
KOKORO_SPEED=1.1
# happy = alegre/animado (Kokoro acelera ~10% e pode acrescentar "!")
KOKORO_SENTIMENT=happy

# Thina (URL que o Home Assistant consegue baixar o WAV)
# --- Stack Docker: http://thina:8080 (compose) — nao altere THINA_PUBLIC_URL ---
# --- Modo nativo + HA no Docker WSL: http://host.docker.internal:<THINA_PORT> ---
# --- HA noutro host na LAN: http://<IP-do-PC>:<THINA_PORT> ---
THINA_HOST=0.0.0.0
THINA_PORT=8080
THINA_PUBLIC_URL=http://192.168.1.100:8080
# Cidade para previsao do tempo / clima quando o usuario nao disser (ex: Sao Paulo)
THINA_DEFAULT_CITY=

# Comandos no PC onde o thina-server roda (lista branca: maps/pc_apps.json)
PC_COMMANDS_ENABLED=false
PC_APPS_MAP_FILE=maps/pc_apps.json

# Google (Gmail, Drive, Calendar) — OAuth
GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TIMEZONE=America/Sao_Paulo
# GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
# GOOGLE_TOKEN_FILE=data/google_token.json

# Personalidade (pode commitar) + pasta privada gitignore (maps/private/*.md)
THINA_USER_CONTEXT_FILE=maps/thina_user.md
THINA_USER_PRIVATE_FILE=maps/thina_user.private.md
THINA_PRIVATE_DIR=maps/private

# Mapeamento area_id -> media_player
AREAS_MAP_FILE=maps/areas.json

# MCP subprocess (modulo servidor FastMCP)
MCP_SERVER_MODULE=thina.llm.gemini_mcp

# Timeouts (segundos)
HA_TIMEOUT=30
KOKORO_TIMEOUT=60
GEMINI_TIMEOUT=90

# Retencao de arquivos de audio temporarios (horas)
AUDIO_RETENTION_HOURS=24

# Conversa multi-turno (session_id em /v1/conversar)
CONVERSATION_MAX_TURNS=10
CONVERSATION_TTL_SECONDS=600

# Logs
LOG_LEVEL=INFO
