# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Kokoro (repo separado, porta 8000)
# Caminho para o repo kokoro (padrao: ../kokoro). Usado por scripts/start-services.ps1
KOKORO_DIR=../kokoro
KOKORO_SERVER_URL=http://localhost:8000
# thina_mix = media igual das vozes em kokoro/assets/voices/*/ (*.pt)
# Alternativa: KOKORO_VOICE=pf_dora + KOKORO_MIX_VOICE=if_sara + KOKORO_MIX_AMOUNT=0.5
KOKORO_VOICE=thina_mix
KOKORO_MIX_VOICE=
KOKORO_MIX_AMOUNT=0.0
KOKORO_SPEED=1.0
KOKORO_SENTIMENT=neutral

# Thina (URL que o Home Assistant consegue baixar o WAV)
THINA_HOST=0.0.0.0
THINA_PORT=8080
THINA_PUBLIC_URL=http://192.168.1.100:8080

# Mapeamento area_id -> media_player
AREAS_MAP_FILE=maps/areas.json

# MCP subprocess (modulo servidor FastMCP)
MCP_SERVER_MODULE=services.gemini_mcp

# Timeouts (segundos)
HA_TIMEOUT=30
KOKORO_TIMEOUT=60
GEMINI_TIMEOUT=90

# Retencao de arquivos de audio temporarios (horas)
AUDIO_RETENTION_HOURS=24

# Logs
LOG_LEVEL=INFO
